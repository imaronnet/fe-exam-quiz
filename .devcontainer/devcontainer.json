{
  "name": "FE Exam Quiz",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "postCreateCommand": "npm ci",
  "postAttachCommand": {
    "server": ".devcontainer/start-vite.sh"
  },
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "FE Exam Quiz",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
